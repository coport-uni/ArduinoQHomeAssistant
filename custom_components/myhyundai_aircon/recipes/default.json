{
  "version": 1,
  "baseline_screen": "AUTO",
  "package": "com.hyundai.oneapp.kr",
  "login_markers": ["LOGIN_MARKER_PLACEHOLDER"],
  "sequences": {
    "aircon_on": {
      "description": "홈 화면 위젯의 공조 켜기 버튼 탭. 노드 식별자와 알림 문구는 2026-09-01 실기기 관찰로 확정(확인 팝업 없음, 성공 알림 '공조가 켜졌습니다.'). 실패 문구(U6)는 아직 미관찰이라 비워 둠 — 실패 시 E_TIMEOUT으로 판정된다.",
      "steps": [
        { "action": "assert_screen" },
        { "action": "wake" },
        { "action": "home" },
        { "action": "wait_focus", "pattern": "Launcher", "timeout": 5 },
        {
          "action": "wait_node",
          "match": {
            "content_desc": "공조 켜기",
            "package": "com.hyundai.oneapp.kr"
          },
          "timeout": 5
        },
        {
          "action": "tap_node",
          "match": {
            "content_desc": "공조 켜기",
            "package": "com.hyundai.oneapp.kr"
          },
          "timeout": 5
        },
        {
          "action": "await_notification",
          "success_contains": ["공조가 켜졌습니다"],
          "failure_contains": [],
          "timeout": 60
        }
      ]
    },
    "aircon_off": {
      "description": "홈 화면 위젯의 공조 끄기 버튼 탭(U7: 위젯에 끄기 버튼 존재 확인됨). 성공 알림 '공조가 꺼졌습니다.' 실측 확정.",
      "steps": [
        { "action": "assert_screen" },
        { "action": "wake" },
        { "action": "home" },
        { "action": "wait_focus", "pattern": "Launcher", "timeout": 5 },
        {
          "action": "wait_node",
          "match": {
            "content_desc": "공조 끄기",
            "package": "com.hyundai.oneapp.kr"
          },
          "timeout": 5
        },
        {
          "action": "tap_node",
          "match": {
            "content_desc": "공조 끄기",
            "package": "com.hyundai.oneapp.kr"
          },
          "timeout": 5
        },
        {
          "action": "await_notification",
          "success_contains": ["공조가 꺼졌습니다"],
          "failure_contains": [],
          "timeout": 60
        }
      ]
    }
  }
}
